# Include pipeline specific rules
include: "rules/common.smk"


# 'All' rule, must be specified before any other modules are
# included, since they also contain 'All' rule
rule all:
    input:
        compile_output_file_list,


module alignment:
    snakefile:
        github(
            "hydra-genetics/alignment",
            path="workflow/Snakefile",
            tag=config.get("module_versions", {}).get("alignment", "v0.7.0"),
        )
    config:
        config


module annotation:
    snakefile:
        github(
            "hydra-genetics/annotation",
            path="workflow/Snakefile",
            tag=config.get("module_versions", {}).get("annotation", "v1.2.0"),
        )
    config:
        config


module cnv_sv:
    snakefile:
        github(
            "hydra-genetics/cnv_sv",
            path="workflow/Snakefile",
            tag=config.get("module_versions", {}).get("cnv_sv", "v2.0.0"),
        )
    config:
        config


module filtering:
    snakefile:
        github(
            "hydra-genetics/filtering",
            path="workflow/Snakefile",
            tag=config.get("module_versions", {}).get("filtering", "v1.1.0"),
        )
    config:
        config


# mark duplicates in CCS reads
module prealignment:
    snakefile:
        github(
            "hydra-genetics/prealignment",
            path="workflow/Snakefile",
            tag=config.get("module_versions", {}).get("prealignment", "v1.4.0"),
        )
    config:
        config


module reports:
    snakefile:
        github(
            "hydra-genetics/reports",
            path="workflow/Snakefile",
            tag=config.get("module_versions", {}).get("reports", "f5ff8bd"),
        )
    config:
        config


module snv_indels:
    snakefile:
        github(
            "hydra-genetics/snv_indels",
            path="workflow/Snakefile",
            tag=config.get("module_versions", {}).get("snv_indels", "v2.0.0"),
        )
    config:
        config


module qc:
    snakefile:
        github(
            "hydra-genetics/qc",
            path="workflow/Snakefile",
            tag=config.get("module_versions", {}).get("qc", "v0.6.0"),
        )
    config:
        config


# QC stuff
use rule mosdepth from qc as qc_mosdepth with:
    input:
        bam="alignment/pbmm2_align/{sample}_{type}.bam",
        bai="alignment/pbmm2_align/{sample}_{type}.bam.bai",


use rule multiqc_longread from qc as qc_multiqc_longread


use rule sequali from qc as qc_sequali


use rule picard_collect_alignment_summary_metrics from qc as qc_picard_collect_alignment_summary_metrics with:
    input:
        bam="alignment/pbmm2_align/{sample}_{type}.bam",
        bai="alignment/pbmm2_align/{sample}_{type}.bam.bai",
        ref=config.get("reference", {}).get("fasta", ""),


use rule picard_collect_hs_metrics from qc as qc_picard_collect_hs_metrics with:
    input:
        bam="alignment/pbmm2_align/{sample}_{type}.bam",
        bai="alignment/pbmm2_align/{sample}_{type}.bam.bai",
        bait_intervals=config.get("reference", {}).get("design_intervals", ""),
        reference=config.get("reference", {}).get("fasta", ""),
        target_intervals=config.get("reference", {}).get("design_intervals", ""),


# MAPPING
use rule pbmarkdup from prealignment as prealignment_pbmarkdup


use rule pbmm2_index from alignment as alignment_pbmm2_index


use rule pbmm2_align from alignment as alignment_pbmm2_align with:
    input:
        query="prealignment/pbmarkdup/{sample}_{type}_{processing_unit}_{barcode}.bam",
        reference=expand(
            "alignment/pbmm2_index/{ref}.{preset}.mmi",
            ref=os.path.basename(config.get("reference", {}).get("fasta", "")),
            preset=config.get("pbmm2_align", {}).get("preset", ""),
        ),


# output: bam=temp("alignment/pbmm2_align/{sample}_{type}.bam")
use rule pbmm2_merge from alignment as alignment_pbmm2_merge


use rule samtools_index from alignment as alignment_samtools_index_pbmm2 with:
    wildcard_constraints:
        file="^alignment/pbmm2_align/.+",


# vacmap
use rule vacmap_align from alignment as alignment_vacmap_align


# output "alignment/vacmap_align/{sample}_{type}.bam"
use rule vacmap_merge from alignment as alignment_vacmap_merge


use rule samtools_index from alignment as alignment_samtools_index_vacmap_merge with:
    wildcard_constraints:
        file="^alignment/vacmap_align/.+",


# SNV & INDELS
use rule clairs_to_call from snv_indels as snv_indels_clairs_to_call


use rule clairs_to_concat from snv_indels as snv_indels_clairs_to_concat with:
    output:
        vcf=temp("snv_indels/clairs_to/{sample}_{type}.vcf.gz"),


# SNV & INDELS from DeepSomatic-TO
# use custom PoN from config
# post-calling filtering by regions BED is not needed here
use rule deepsomatic_t_only from snv_indels as snv_indels_deepsomatic_t_only with:
    wildcard_constraints:
        type="T",


# fix AF entries
use rule fix_af from snv_indels as snv_indels_fix_af with:
    input:
        vcf=get_snv_caller_output,
    output:
        vcf=temp("snv_indels/fix_af/{sample}_{type}.vcf"),
    log:
        "snv_indels/fix_af/{sample}_{type}.vcf.log",
    benchmark:
        repeat(
            "snv_indels/fix_af/{sample}_{type}.vcf.benchmark.tsv",
            config.get("fix_af", {}).get("benchmark_repeats", 1),
        )


# Phase SNV output with fixed AF
use rule whatshap_phase from snv_indels as snv_indels_whatshap_phase with:
    input:
        bam=lambda wildcards: get_input_aligned_bam(wildcards, config)[0],
        bai=lambda wildcards: get_input_aligned_bam(wildcards, config)[1],
        fasta=config.get("reference", {}).get("fasta", ""),
        vcf="snv_indels/fix_af/{sample}_{type}.vcf",


# index the phased vcf from your SNV caller
use rule tabix from cnv_sv as cnv_sv_tabix_snv_vcf with:
    wildcard_constraints:
        file="^snv_indels/whatshap_phase/.+\.phased",


# intput:
# vcf="{file}.vcf.gz",
# tabix="{file}.vcf.gz.tbi",
# output: vcf=temp("{file}.include.{tag}.vcf.gz"),
use rule bcftools_filter_include_region from filtering as filtering_bcftools_filter_include_region_snv_vcf with:
    wildcard_constraints:
        file="^snv_indels/whatshap_phase/.+\.phased",


# output: "snv_indels/whatshap_haplotag/{sample}_{type}.haplotagged.bam"
use rule whatshap_haplotag from snv_indels as snv_indels_whatshap_haplotag


use rule samtools_index from alignment as alignment_samtools_index_haplotagged_bam with:
    wildcard_constraints:
        file="^snv_indels/whatshap_haplotag/.+\.haplotagged",


# STRUCTURAL VARIANTS
# run Sniffles2 on VACmap made and haplotagged BAM
use rule sniffles2_call from cnv_sv as cnv_sv_sniffles2 with:
    input:
        bam=lambda wildcards: get_input_haplotagged_bam(wildcards, config)[0],
        bai=lambda wildcards: get_input_haplotagged_bam(wildcards, config)[1],
        ref=config.get("reference", {}).get("fasta", ""),


# bgzip & tabix Sniffles2 VCF
use rule bgzip from cnv_sv as cnv_sv_bgzip_sniffles with:
    wildcard_constraints:
        file="cnv_sv/sniffles2_call/.+",


use rule tabix from cnv_sv as cnv_sv_tabix_sniffles with:
    wildcard_constraints:
        file="cnv_sv/sniffles2_call/.+",


# filter Sniffles2 results
use rule bcftools_filter_include_region from filtering as filtering_bcftools_filter_include_region_sniffles with:
    wildcard_constraints:
        file="cnv_sv/sniffles2_call/.+",


# severus
use rule severus_t_only from cnv_sv as cnv_sv_severus_t_only

# PBSV
use rule pbsv_call from cnv_sv as cnv_sv_pbsv_call


use rule pbsv_discover from cnv_sv as cnv_sv_pbsv_discover with:
    input:
        bam="alignment/pbmm2_align/{sample}_{type}.bam",
        bai="alignment/pbmm2_align/{sample}_{type}.bam.bai",


# SVDB
use rule svdb_merge from cnv_sv as cnv_sv_svdb_merge with:
    input:
        vcfs=lambda wildcards: get_local_vcfs_for_svdb_merge(wildcards, add_suffix=False),
    params:
        extra=config.get("svdb_merge", {}).get("extra", ""),
        overlap=config.get("svdb_merge", {}).get("overlap", 0.6),
        bnd_distance=config.get("svdb_merge", {}).get("bnd_distance", 10000),
        priority=get_svdb_merge_priority,
        vcfs=lambda wildcards: get_local_vcfs_for_svdb_merge(wildcards, add_suffix=True),


use rule svdb_query from cnv_sv as cnv_sv_svdb_query


# CNVkit by default uses config-defined aligner to construct path to BAM
use rule cnvkit_batch from cnv_sv as cnv_sv_cnvkit_batch with:
    input:
        bam="alignment/pbmm2_align/{sample}_{type}.bam",
        bai="alignment/pbmm2_align/{sample}_{type}.bam.bai",
        reference=config.get("cnvkit_batch", {}).get("normal_reference", ""),


# index phased.inlcude.panel.vcf
use rule tabix from cnv_sv as cnv_sv_tabix_include_panel with:
    wildcard_constraints:
        file="^snv_indels/whatshap_phase/.+\.phased\.include\.panel",


use rule vep from annotation as annotation_vep with:
    wildcard_constraints:
        file="snv_indels/whatshap_phase/.+\.phased\.include\.panel",


# vep output has to be bgzipped and indexed
use rule bgzip from cnv_sv as bgzip_vep_vcf with:
    wildcard_constraints:
        file="snv_indels/whatshap_phase/.+_[TN]\.phased\.include\.panel\.vep_annotated",
    input:
        vcf="{file}.vcf",
    output:
        gz=temp("{file}.vcf.gz"),


use rule tabix from cnv_sv as tabix_vep_vcf with:
    wildcard_constraints:
        file="snv_indels/whatshap_phase/.+_[TN]\.phased\.include\.panel\.vep_annotated",


# now you can filter it (keep the populational variants)
# output: vcf=temp("{file}.filter.{tag}.vcf"), tag='germline'
use rule filter_vcf from filtering as filtering_filter_vep_annotated_vcf with:
    wildcard_constraints:
        file="snv_indels/whatshap_phase/.+\.phased\.include\.panel\.vep_annotated",


# gzip this file
use rule bgzip from cnv_sv as bgzip_filtered_vep_vcf with:
    wildcard_constraints:
        file="snv_indels/whatshap_phase/.+\.phased\.include\.panel\.vep_annotated\.filter\.germline",


# filter out NonSomatic variants
# output: vcf=temp("{file}.bcftools_view.{tag}.vcf.gz"),
# tag="germline",
use rule bcftools_view from filtering as filtering_bcftools_view_nonsomatic with:
    wildcard_constraints:
        file="snv_indels/whatshap_phase/.+\.phased\.include\.panel\.vep_annotated\.filter\.germline",


# calls cnvs with loh into cns file
# outputs loh.cns file
use rule cnvkit_call from cnv_sv as cnv_sv_cnvkit_call with:
    wildcard_constraints:
        tc_method="pathology",
    input:
        segment="cnv_sv/cnvkit_batch/{sample}/{sample}_{type}.cns",
        vcf="snv_indels/whatshap_phase/{sample}_{type}.phased.include.panel.vep_annotated.filter.germline.bcftools_view.germline.vcf.gz",
        tc_file=get_tc_file,
    params:
        extra=config.get("cnvkit_call", {}).get("extra", ""),
        purity=config.get("cnvkit_call", {}).get("purity", 0.9),


# this one takes the loh file from cnvkit_call
use rule cnvkit_vcf from cnv_sv as cnv_sv_cnvkit_vcf with:
    wildcard_constraints:
        tc_method="pathology",


use rule annotate_cnv from annotation as annotation_annotate_cnvkit_vcf with:
    input:
        vcf="cnv_sv/cnvkit_vcf/{sample}_{type}.pathology.vcf",
    output:
        vcf=temp("cnv_sv/cnvkit_vcf/{sample}_{type}.pathology.annotate_cnv.{tag}.vcf"),
    params:
        bed=lambda wildcards: config.get("annotate_cnv", {}).get(wildcards.tag, ""),
    log:
        "cnv_sv/cnvkit_vcf/{sample}_{type}.pathology.annotate_cnv.{tag}.vcf.log",
    benchmark:
        repeat(
            "cnv_sv/cnvkit_vcf/{sample}_{type}.pathology.annotate_cnv.{tag}.vcf.benchmark.tsv",
            config.get("annotate_cnv", {}).get("benchmark_repeats", 1),
        )


# one more round of bgzip+tabix
use rule bgzip from cnv_sv as cnv_sv_bgzip_cnvkit_vcf with:
    wildcard_constraints:
        file="cnv_sv/cnvkit_vcf/.+\.pathology\.annotate_cnv\.germline",


use rule tabix from cnv_sv as cnv_sv_tabix_cnvkit_vcf with:
    wildcard_constraints:
        file="cnv_sv/cnvkit_vcf/.+\.pathology\.annotate_cnv\.germline",


# CNVkit reports
# the inputs here are cns and cnr files from cnvkit_batch
# t.ex.: "cnv_sv/cnvkit_batch/{sample}/{sample}_{type}.cns"
# output: json=temp("reports/cnv_html_report/{sample}_{type}.{caller}.{tc_method}.json"),
use rule cnv_json from reports as reports_cnv_json with:
    wildcard_constraints:
        tc_method="pathology",
        caller="cnvkit",
    input:
        ratios="cnv_sv/cnvkit_batch/{sample}/{sample}_{type}.cnr",
        segments="cnv_sv/cnvkit_batch/{sample}/{sample}_{type}.cns",
        annotations=config.get("merge_cnv_json", {}).get("annotations", []),


# this one has filtered_cnv_vcfs, cnv_vcfs, germline_vcf as input
# germline_vcf is pulled from config
# ["reports/cnv_html_report/{sample}_{type}.{caller}.{tc_method}.json".format(caller=c, **wildcards) for c in callers]
# to see ALL input files, check out config: merge_cnv_json
# output: "reports/cnv_html_report/{sample}_{type}.{tc_method}.merged.json"
use rule merge_cnv_json from reports as reports_merge_cnv_json


use rule cnv_html_report from reports as reports_cnv_html_report with:
    input:
        json="reports/cnv_html_report/{sample}_{type}.{tc_method}.merged.json",
        html_template="workflow/templates/cnv_html_report/index.html",
        js_files=[
            "workflow/templates/assets/js/d3.v7.min.js",
            "workflow/templates/cnv_html_report/01-chromosome-plot.js",
            "workflow/templates/cnv_html_report/02-genome-plot.js",
            "workflow/templates/cnv_html_report/03-results-table.js",
            "workflow/templates/cnv_html_report/04-window-summary.js",
            "workflow/templates/cnv_html_report/05-main.js",
        ],
        css_files=[
            "workflow/templates/assets/css/icons.css",
            "workflow/templates/cnv_html_report/style.css",
        ],
        tc_file=get_tc_file,
        extra_table_files=[t["path"] for t in config.get("cnv_html_report", {}).get("extra_tables", [])],


# Excel report with SNVs and SVs
rule reports_compile_xlsx_report:
    input:
        vcf_snv="snv_indels/whatshap_phase/{sample}_{type}.phased.include.panel.vep_annotated.vcf.gz",
        vcf_sv="cnv_sv/svdb_query/{sample}_{type}.pathology.svdb_query.vcf",
        vcf_cnv="cnv_sv/cnvkit_vcf/{sample}_{type}.pathology.annotate_cnv.germline.vcf",
    output:
        xlsx=temp("reports/xlsx_reports/{sample}_{type}_combined_report.xlsx"),
    params:
        filter_config=config.get("compile_xlsx_report", {}).get("filters", []),
        genes_bed=config.get("compile_xlsx_report", {}).get("genes", ""),
    log:
        "reports/xlsx_reports/{sample}_{type}_combined_report.xlsx.log",
    benchmark:
        repeat(
            "reports/xlsx_reports/{sample}_{type}_combined_report.xlsx.benchmark.tsv",
            config.get("compile_xlsx_report", {}).get("benchmark_repeats", 1),
        )
    threads: config.get("compile_xlsx_report", {}).get("threads", config["default_resources"]["threads"])
    resources:
        mem_mb=config.get("compile_xlsx_report", {}).get("mem_mb", config["default_resources"]["mem_mb"]),
        mem_per_cpu=config.get("compile_xlsx_report", {}).get("mem_per_cpu", config["default_resources"]["mem_per_cpu"]),
        partition=config.get("compile_xlsx_report", {}).get("partition", config["default_resources"]["partition"]),
        threads=config.get("compile_xlsx_report", {}).get("threads", config["default_resources"]["threads"]),
        time=config.get("compile_xlsx_report", {}).get("time", config["default_resources"]["time"]),
    container:
        config.get("compile_xlsx_report", {}).get("container", config["default_container"])
    message:
        "{rule}: compile SNV and SV VCFs into Excel report for {wildcards.sample}_{wildcards.type}"
    script:
        "scripts/compile_xlsx_report.py"
